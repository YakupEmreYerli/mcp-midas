# Midas login credentials (Turkish phone number without country code, and password)
MIDAS_PHONE=5XXXXXXXXX
MIDAS_PASSWORD=your-password

# Run the browser headless (true) or visible (false). Leave true: the server opens a
# visible window on its own when a login is actually needed.
HEADLESS=true

# Extra order-value ceiling in TRY. This never bypasses or replaces desktop confirmation.
MAX_ORDER_VALUE_TRY=10000
