# Midas giriş bilgileri (ülke kodu olmadan cep telefonu ve şifre). İsteğe bağlı: boş
# bırakırsan giriş gerektiğinde tarayıcı penceresi açılır, bilgileri kendin yazarsın.
MIDAS_PHONE=5XXXXXXXXX
MIDAS_PASSWORD=sifren

# Arayüz dili: tr ya da en (pencereler, bildirimler, araç açıklamaları, hata mesajları, loglar).
# Verilmezse sistem yereline bakılır: LC_ALL, LC_MESSAGES, LANG sırasıyla; "tr" ile başlıyorsa
# Türkçe, değilse İngilizce. Verilmezse onay ve SMS kodu pencereleri açıldıkları cihazın dilini
# kullanır (başka bir makinede açılan pencere o makinenin dilinde); verilirse pencereler de bu dilde.
# MIDAS_LANG=tr

# Tarayıcıyı başsız (true) ya da görünür (false) çalıştır. true bırak: gerçekten giriş
# gerektiğinde sunucu görünür pencereyi kendisi açar.
HEADLESS=true

# Oturum düştüğünde giriş tarayıcısı: hidden (varsayılan; pencere XWayland'da açılır, KDE'de
# KWin betiğiyle küçültülüp ekran dışına alınır, telefondaki bildirimi onaylaman yeter),
# visible (eski davranış: görünür pencere), headless (formu başsız dener; Cloudflare
# doğrulaması geçmezse form gönderilmeden hidden kipine düşer).
# MIDAS_LOGIN_WINDOW=hidden

# Formdan sonraki doğrulama: push (telefondaki bildirimi onaylarsın, varsayılan) ya da sms
# (mobil onay ekranında "SMS ile giriş yap" seçilir; yerel masaüstünde kod SMS kodu
# penceresinde sorulur, açılamazsa Midas penceresine sen yazarsın).
# MIDAS_LOGIN_METHOD=push

# SMS kodunu soracak komut (JSON dizi); yerel SMS kodu penceresinin yerine geçer. Komut
# stdin'den {"hesapEtiketi", "sureSn", "dil"} alır, kodu stdout'a yazıp 0 ile çıkar.
# MIDAS_SMS_CODE_COMMAND=["python3","/mutlak/yol/mcp-midas/onay/sms.py"]

# HTTP servisinde oturumu başsız yoklayıp durumu kaydeden canlı tutma aralığı (saat).
# 0 kapatır. Oturum düşmüşse döngü giriş başlatmaz, yalnız loglar.
# MIDAS_KEEPALIVE_HOURS=4

# Boştaki tarayıcı son araç çağrısından bu kadar dakika sonra kapanır; sonraki çağrı kayıtlı
# oturumu sessizce yeniden açar. 0 kapatır (tarayıcı açık kalır).
# MIDAS_IDLE_CLOSE_MINUTES=10

# TL cinsinden ek emir tutarı tavanı. Masaüstü onayını hiçbir zaman atlatmaz, onun yerine geçmez.
MAX_ORDER_VALUE_TRY=10000

# Emir araçları (place_order, update_order, cancel_order) varsayılan kapalıdır; yalnızca bu
# değer tam olarak 1 olduğunda kaydedilir. Her emir yine masaüstü onayı ister.
# MIDAS_ORDERS_ENABLED=1

# Birden çok hesap: oturum profili, .midas-state.json ve emir günlüğünün dizini (mutlak yol;
# verilmezse proje kökü) ve sonuçlarda, onay penceresinde görünen hesap adı. Her hesap ayrı
# bir süreçtir; HTTP serviste MIDAS_HTTP_PORT ve MIDAS_TOKEN_FILE da ayrı verilir.
# MIDAS_DATA_DIR=/mutlak/yol/veri/personal
# MIDAS_ACCOUNT_LABEL=personal

# İsteğe bağlı, varsayılan kapalı: onay penceresini başka bir makinede de açan komut (JSON
# dizi). Komut öteki makinede aynı onay/onay.py penceresini çalıştırmalı. Bu ayar onay
# güvenini taşır; README'deki güven modeli bölümünü oku.
# MIDAS_CONFIRM_REMOTE=["ssh","-i","/etc/mcp-midas/onay_ed25519","kullanici@masaustu"]
# MIDAS_CONFIRM_REMOTE_CLOSE=["ssh","-i","/etc/mcp-midas/kapat_ed25519","kullanici@masaustu"]
# Yerel onay penceresi komutunun yerine geçer (ekranına bakılmayan makine); kdialog/zenity çalışmaz.
# MIDAS_CONFIRM_LOCAL=["ssh","-i","/etc/mcp-midas/onay_ed25519","kullanici@masaustu"]
