# Midas giriş bilgileri (ülke kodu olmadan cep telefonu ve şifre)
MIDAS_PHONE=5XXXXXXXXX
MIDAS_PASSWORD=sifren

# Tarayıcıyı başsız (true) ya da görünür (false) çalıştır. true bırak: gerçekten giriş
# gerektiğinde sunucu görünür pencereyi kendisi açar.
HEADLESS=true

# Oturum düştüğünde giriş tarayıcısı: hidden (varsayılan; pencere XWayland'da açılır, KDE'de
# KWin betiğiyle küçültülüp ekran dışına alınır, telefondaki bildirimi onaylaman yeter),
# visible (eski davranış: görünür pencere), headless (formu başsız dener; Cloudflare
# doğrulaması geçmezse form gönderilmeden hidden kipine düşer).
# MIDAS_LOGIN_WINDOW=hidden

# HTTP servisinde oturumu başsız yoklayıp durumu kaydeden canlı tutma aralığı (saat).
# 0 kapatır. Oturum düşmüşse döngü giriş başlatmaz, yalnız loglar.
# MIDAS_KEEPALIVE_HOURS=4

# TL cinsinden ek emir tutarı tavanı. Masaüstü onayını hiçbir zaman atlatmaz, onun yerine geçmez.
MAX_ORDER_VALUE_TRY=10000

# Emir araçları (place_order, update_order, cancel_order) varsayılan kapalıdır; yalnızca bu
# değer tam olarak 1 olduğunda kaydedilir. Her emir yine masaüstü onayı ister.
# MIDAS_ORDERS_ENABLED=1
